<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".bai1.MainActivity"
    android:gravity="center"
    android:orientation="vertical">
    <TextView
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hi, Welcome Back! "
        android:textSize="25sp"
        android:textStyle="bold"
        android:drawableEnd="@drawable/waving_hand_svgrepo_com"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        >
        <TextView
            android:id="@+id/tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@id/edtEmail"
            android:text="Email"
            android:textSize="15sp"
            />
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_below="@id/tv2"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:hint=" example@gamil.com"
            android:padding="16dp"
            android:textSize="15sp"
            android:background="@drawable/buttom_custom"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:id="@+id/tv3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@id/et2"
            android:text="Password"
            android:textSize="15sp"
            />
        <RelativeLayout
            android:id="@+id/et2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv3"
            android:layout_marginTop="8dp"
            >
            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="300dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"
                android:hint=" Enter Your Password"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:padding="16dp"
                android:background="@drawable/buttom_custom"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/eye"
                android:layout_centerVertical="true"
                android:layout_alignRight="@+id/edtPassword"
                android:layout_marginEnd="8dp"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <CheckBox
            android:id="@+id/cbRemember"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <TextView
            android:id="@+id/tv4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/cbRemember"
            android:layout_alignBottom="@+id/cbRemember"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="Remember me"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignBottom="@+id/tv4"
            android:textStyle="bold"
            android:text="Forgot password?"
            android:textColor="#FF0000"
            />
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#1877F2"
            android:layout_below="@+id/cbRemember"
            android:text="Login"
            android:layout_marginTop="16dp"
            app:cornerRadius="5dp"
            app:backgroundTint="#1875EE"

            />

    </RelativeLayout>

    <RelativeLayout
        android:layout_height="32dp"
        android:layout_width="300dp"
        android:layout_marginTop="10dp">

        <View
            android:id="@+id/v1"
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:background="#A9A9A9"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:id="@+id/tv5"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:textSize="15sp"
            android:text="Or with"/>
        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:background="#A9A9A9"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <Button
            android:id="@+id/bt2"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#1876F0"
            android:text="            Login with Facebook"
            android:textColor="#FFFFFF"
            app:backgroundTint="@null"
            android:background="@drawable/buttom_custom"
            />
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/facebooklogo"
            android:layout_centerVertical="true"
            />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <Button
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="Login with Goole"
            android:textColor="#A6A6A6"
            app:backgroundTint="@null"
            android:background="@drawable/buttom_custom"/>
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/googlelogo"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/tv6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account ? "/>
        <TextView
            android:id="@+id/tvSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:layout_toRightOf="@+id/tv6"
            android:textColor="#673AB7"
            android:clickable="true"/>
    </RelativeLayout>

</LinearLayout>